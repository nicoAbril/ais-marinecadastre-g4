{
  "datasets": [
    {
      "name": "65d4654c",
      "displayName": "Intensidad de tráfico por celda (trafico_celda_dia)",
      "queryLines": [
        "SELECT h3_celda, lat, lon, buques, posiciones, intensidad ",
        "FROM trafico_celda_dia WHERE fecha = :fecha AND posiciones >= 20 "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d11407ad",
      "displayName": "Buques por hora (trafico_hora)",
      "queryLines": [
        "SELECT hora, SUM(buques) AS buques_hora, SUM(posiciones) AS posiciones ",
        "FROM trafico_hora WHERE fecha = :fecha GROUP BY hora ORDER BY hora "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ab42c5fd",
      "displayName": "Ranking de puertos (puerto_dia)",
      "queryLines": [
        "SELECT nombre_puerto, pais, arribos, buques_presentes, ROUND(horas_promedio, 1) AS horas_promedio ",
        "FROM puerto_dia WHERE fecha = :fecha ORDER BY arribos DESC LIMIT 15 "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "392edcde",
      "displayName": "Buques en puerto (buques_en_puerto_dia)",
      "queryLines": [
        "SELECT nombre_puerto, nombre_buque, categoria, primera_ts, ultima_ts, ",
        "ROUND(horas_en_puerto, 1) AS horas_en_puerto, arribos ",
        "FROM buques_en_puerto_dia WHERE fecha = :fecha AND horas_en_puerto >= :horas_minimas ",
        "ORDER BY nombre_puerto, primera_ts "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "horas_minimas",
          "keyword": "horas_minimas",
          "dataType": "DECIMAL",
          "defaultSelection": {
            "values": {
              "dataType": "DECIMAL",
              "values": [
                {
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "59f66b43",
      "displayName": "Anomalías del día (anomalias_buque_dia)",
      "queryLines": [
        "SELECT tipo, MMSI, nombre_buque, eventos, ROUND(valor_max, 1) AS valor_max, ",
        "ultima_lat AS lat, ultima_lon AS lon, ultimo_detalle AS detalle ",
        "FROM anomalias_buque_dia WHERE fecha = :fecha AND ultima_lat IS NOT NULL "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d549dd2e",
      "displayName": "Resumen del día (kpi_dia)",
      "queryLines": [
        "SELECT buques_activos, arribos, millas, buques_con_anomalias, buques_en_puerto, pct_cuarentena ",
        "FROM kpi_dia WHERE fecha = :fecha "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-10T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    }
