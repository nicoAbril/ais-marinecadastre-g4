{
  "datasets": [
    {
      "name": "65d4654c",
      "displayName": "ds_mapa",
      "queryLines": [
        "SELECT\r\n",
        "  h3,\r\n",
        "  ROUND(AVG(lat_centro), 5)  AS lat,\r\n",
        "  ROUND(AVG(lon_centro), 5)  AS lon,\r\n",
        "  SUM(posiciones)            AS posiciones,\r\n",
        "  MAX(buques)                AS buques_hora_pico,\r\n",
        "  ROUND(AVG(sog_medio_nudos), 1) AS sog_medio,\r\n",
        "    ROUND(LOG10(SUM(posiciones)), 2) AS intensidad\r\n",
        "FROM oceanwatch_lakehouse.gold.trafico_celda_hora\r\n",
        "WHERE fecha = :fecha\r\n",
        "GROUP BY h3\r\n",
        "HAVING SUM(posiciones) >= 20"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d11407ad",
      "displayName": "ds_trafico_hora",
      "queryLines": [
        "SELECT hora,\r\n",
        "       SUM(posiciones) AS posiciones,\r\n",
        "       SUM(buques)     AS buques_hora\r\n",
        "FROM oceanwatch_lakehouse.gold.trafico_celda_hora\r\n",
        "WHERE fecha = :fecha\r\n",
        "GROUP BY hora\r\n",
        "ORDER BY hora"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ab42c5fd",
      "displayName": "ds_ranking_puertos",
      "queryLines": [
        "SELECT\r\n",
        "  nombre_puerto,\r\n",
        "  pais,\r\n",
        "  COUNT(*)                                        AS visitas,\r\n",
        "  SUM(CAST(se_detuvo AS INT))                     AS se_detuvieron,\r\n",
        "  COUNT(*) - SUM(CAST(se_detuvo AS INT))          AS pasaron_de_largo,\r\n",
        "  ROUND(AVG(duracion_horas), 1)                   AS duracion_media_h\r\n",
        "FROM oceanwatch_lakehouse.gold.visitas_puerto\r\n",
        "WHERE Fecha_Entrada = :fecha\r\n",
        "GROUP BY nombre_puerto, pais\r\n",
        "ORDER BY visitas DESC\r\n",
        "LIMIT 20"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "392edcde",
      "displayName": "ds_buques_en_puerto",
      "queryLines": [
        "SELECT\r\n",
        "  nombre_puerto,\r\n",
        "  pais,\r\n",
        "  MMSI,\r\n",
        "  VesselName,\r\n",
        "  Descripcion_Tipo,\r\n",
        "  entrada_ts,\r\n",
        "  salida_ts,\r\n",
        "  duracion_horas,\r\n",
        "  se_detuvo,\r\n",
        "  es_vigente,\r\n",
        "  entrada_censurada\r\n",
        "FROM oceanwatch_lakehouse.gold.visitas_puerto\r\n",
        "WHERE entrada_ts < date_add(:fecha, 1)\r\n",
        "  AND (salida_ts IS NULL OR salida_ts >= :fecha)\r\n",
        "  AND duracion_horas >= :horas_minimas\r\n",
        "ORDER BY nombre_puerto, entrada_ts"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "horas_minimas",
          "keyword": "horas_minimas",
          "dataType": "DECIMAL",
          "defaultSelection": {
            "values": {
              "dataType": "DECIMAL",
              "values": [
                {
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "59f66b43",
      "displayName": "ds_anomalias",
      "queryLines": [
        "SELECT tipo, MMSI, VesselName, ts, LAT, LON, valor, detalle\r\n",
        "FROM oceanwatch_lakehouse.gold.anomalias_dia\r\n",
        "WHERE fecha = :fecha"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d549dd2e",
      "displayName": "ds_resumen",
      "queryLines": [
        "SELECT\r\n",
        "  (SELECT COUNT(*) FROM oceanwatch_lakehouse.gold.trayectorias_diarias WHERE fecha = :fecha)       AS buques_activos,\r\n",
        "  (SELECT ROUND(SUM(distancia_nm)) FROM oceanwatch_lakehouse.gold.trayectorias_diarias WHERE fecha = :fecha) AS millas_navegadas,\r\n",
        "  (SELECT COUNT(*) FROM oceanwatch_lakehouse.gold.visitas_puerto WHERE Fecha_Entrada = :fecha)     AS entradas_a_puerto,\r\n",
        "  (SELECT COUNT(DISTINCT MMSI) FROM oceanwatch_lakehouse.gold.anomalias_dia WHERE fecha = :fecha) AS buques_con_anomalias"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    }
  ],
